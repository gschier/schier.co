{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3200",
    "generate-routes": "tsr generate",
    "build": "prisma generate && vite build && node scripts/no-maps.mjs",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "migrate": "node scripts/migrate.mjs",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/db.test.ts test/newsletter.test.ts test/assets.test.ts test/markdown.test.ts test/mcp.test.ts test/pages.test.ts test/admin.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@openpanel/web": "^1.4.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^11.5.0",
    "@sentry/tanstackstart-react": "^11.5.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "dotenv": "^18.0.4",
    "nitro": "3.0.260610-beta",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.0.0",
    "tailwindcss": "^4.1.18",
    "unified": "^11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.1",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright-core": "^1.64.0",
    "rehype-parse": "^9.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
