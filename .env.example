# Pooled connection (Railway in production, direct locally).
DATABASE_URL=postgresql://schierco:schierco@localhost:5439/schierco
# Direct connection for migrations.
DIRECT_URL=postgresql://schierco:schierco@localhost:5439/schierco
# The site's own address, for absolute links in feeds and emails.
BASE_URL=http://localhost:3200
# The admin's secret: bearer token for /mcp and the token that signs in at
# /admin?token=... (src/server/admin.ts). On a dev server any token signs
# in, so it can stay empty locally.
MCP_TOKEN=

# Images, served at /media/{key} (src/server/storage.ts). Without the
# bucket below they are kept in a directory instead: ASSETS_DIR, relative to
# web/ (default .media, gitignored).
ASSETS_DIR=
# Dev only: where to fetch an image the directory lacks, once, keeping it
# in ASSETS_DIR, so real posts show their images. Never used in production.
# Empty fetches nothing. While the DigitalOcean Space lives, its CDN:
# https://schierco.nyc3.cdn.digitaloceanspaces.com
ASSETS_FALLBACK_URL=

# Railway bucket "assets" (src/server/s3.ts), from `railway bucket
# credentials --bucket assets`. Optional; when set, images are kept there
# and not in ASSETS_DIR. Leave it empty locally.
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto

# Resend, for the newsletter (src/server/mail.ts). Without a key every
# email is written to the console, not sent, so local runs need none.
RESEND_API_KEY=
# Who emails are from. Optional; defaults to Gregory Schier
# <greg@mail.schier.co>. Its domain must be verified in Resend.
MAIL_FROM=
# Where replies go. Optional; defaults to greg@schier.co.
REPLY_TO=

# Sentry, server errors only. Optional; nothing is sent until set.
SENTRY_DSN=
# OpenPanel page views (browser). Optional; nothing is sent until set.
# Public id.
VITE_OPENPANEL_CLIENT_ID=
